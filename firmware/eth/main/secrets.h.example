/* Template only - real values live in secrets.h, which is gitignored.
 * Generate with:  tools/gen_secrets.sh
 * Every node in the fleet must build against the SAME secrets.h. */
#pragma once

#define BIOHO_OTA_KEY "replace-me-run-tools-gen_secrets.sh"
#define BIOHO_PMK { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }
#define BIOHO_LMK { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

/* The crown's reserved LAN address (outside your DHCP pool) and your LAN's
 * gateway - the two deployment specifics the blades need. These are
 * documentation placeholders (RFC 5737) and route nowhere. */
#define BIOHO_CROWN_IP "192.0.2.2"
#define BIOHO_CROWN_GW "192.0.2.1"

/* Home WiFi, used ONLY by the observers' touch-opened OTA window
 * (docs/firmware/ota_deployments.md). Leave empty to disable the window
 * entirely - the trigger then refuses with "no wifi creds" on the glass.
 * Blades never read these. */
#define BIOHO_WIFI_SSID ""
#define BIOHO_WIFI_PASS ""

